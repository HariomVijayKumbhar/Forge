# --- Forge Backend Configuration ---
APP_NAME="Forge Autonomous Agent"
DEBUG=true

# Security & Authentication
ACCESS_PASSWORD=forge-dev-secret
ACCESS_TOKEN_SECRET=dev-super-secret-access-token-key-change-in-prod-32chars
REFRESH_TOKEN_SECRET=dev-super-secret-refresh-token-key-change-in-prod-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
ALLOWED_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://forge-phi-navy.vercel.app

# LLM Providers (configure at least one; OpenRouter and Groq use the OpenAI-compatible APIs)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER_CHAIN=groq,openrouter,gemini-flash,claude
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Execution Sandbox Limits
MAX_ITERATIONS=25
RUN_TIMEOUT_SECONDS=600
CONSECUTIVE_FAILURES_LIMIT=3
ENABLE_DOCKER_SANDBOX=false
SANDBOX_DOCKER_IMAGE=python:3.12-slim
SANDBOX_TEMP_ROOT=./sandbox_workspaces

# GitHub Integration
GITHUB_TOKEN=

# Database Configuration:
#
# To get your Supabase connection string:
#   1. Go to https://supabase.com and create (or open) your project.
#   2. In the Supabase dashboard, navigate to: Settings -> Database -> Connection string.
#   3. Copy the "URI" format connection string (it looks like:
#      postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres)
#   4. Replace the placeholder values below with your actual credentials.
#   5. Paste the full connection string as the value for DATABASE_URL.
#
# Passwords containing reserved URL characters must be percent-encoded.
# For example, use %40 for @, %23 for #, and %25 for %.
# Supabase Postgres (use this for staging/production):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Local SQLite (default for offline development):
DATABASE_URL=sqlite:///forge.db
